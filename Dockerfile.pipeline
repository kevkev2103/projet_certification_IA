FROM python:3.10-slim

# Installer les dépendances système nécessaires
RUN apt-get update && apt-get install -y \
    curl \
    pkg-config \
    default-libmysqlclient-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copier les requirements du projet principal
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copier les scripts de pipeline
COPY prediction_pipeline.py .
COPY clean_predictions_fictives.py .

# Copier les données nécessaires
COPY fictif/ ./fictif/

# Script d'attente pour les services
COPY wait-for-services.sh .
RUN chmod +x wait-for-services.sh

# Commande par défaut
CMD ["python", "prediction_pipeline.py"]