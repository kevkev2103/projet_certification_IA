# =================================================================
# CONFIGURATION DOCKER CINAPPS PROJECT - BASÉE SUR VOS .ENV EXISTANTS
# =================================================================
# Copiez ce fichier vers .env pour Docker

# ===== BASE DE DONNÉES MYSQL =====
# Valeurs extraites de votre .env racine
MYSQL_ROOT_PASSWORD=motdepasseadmin
MYSQL_DATABASE=cinapps
MYSQL_USER=kevin
MYSQL_PASSWORD=kevinpass

# ===== AUTHENTIFICATION JWT =====
# Secret pour les tokens JWT (extrait de votre cinapps_api/.env)
JWT_SECRET_KEY=la_clé_secrète_pour_JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== SECRET KEY GÉNÉRAL =====
# Secret key principal (extrait de votre .env racine)
SECRET_KEY=b979397eea5af4b6b0ea85bd97d2bf3438677e0c7e47c17ec50bd57b80c7a996c3cb37d5bb380a9edb029ee6088afdd9aee1ce72e6921642eb3b201a7af03de

# ===== MONITORING =====
GRAFANA_PASSWORD=admin123

# ===== URLS INTERNES DOCKER =====
# Ces URLs sont configurées pour la communication inter-containers
URL_API_CRUD=http://cinapps-api:8000
URL_API_PRED=http://prediction-api:8001

# ===== DATABASE URLS POUR CONTAINERS =====
# URLs de base de données adaptées pour Docker
DATABASE_URL=mysql+pymysql://kevin:kevinpass@mysql:3306/cinapps?charset=utf8mb4
DATABASE_URL_SIMPLE=mysql+pymysql://kevin:kevinpass@mysql:3306/cinapps